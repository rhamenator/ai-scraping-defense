# sample.env.min
#
# Minimal variables for local testing.
# Copy this file to .env and fill in your values.

# Detection model configuration
MODEL_URI=sklearn:///app/models/bot_detection_rf_model.joblib
PYTHON_VERSION=3.14
RUST_VERSION=1.88

# HashiCorp Vault (optional, for enhanced secret management)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=

# Optional API keys for model providers
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Optional MCP server (set MODEL_URI=mcp://primary/<tool> to enable)
ENABLE_MCP_MODEL=false
# MCP_SERVER_PRIMARY_URL=ws://localhost:8085/mcp

# Optional integration key
EXTERNAL_API_KEY=

# Service ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
APACHE_HTTP_PORT=8080
ADMIN_UI_PORT=5002
# Admin UI credentials
ADMIN_UI_USERNAME=your_admin_username_here
# Required: set a strong bcrypt hash; service will fail if unset
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'new_password', bcrypt.gensalt()).decode())"
ADMIN_UI_PASSWORD_HASH=$2b$12$KIXQ4b1rQJ8Q9QJ8Q9QJ8uQJ8Q9QJ8Q9QJ8Q9QJ8Q9QJ8Q9QJ8Q9Q  # WARNING: Replace with a secure bcrypt hash before deployment!
PROMPT_ROUTER_HOST=prompt_router
PROMPT_ROUTER_PORT=8009
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Only used with: docker compose --profile auto-update up -d  (seconds between checks)
WATCHTOWER_INTERVAL=86400

# Backend targets
REAL_BACKEND_HOSTS=http://localhost:8082
REAL_BACKEND_HOST=http://localhost:8082
CLOUD_DASHBOARD_API_KEY=
RECOMMENDER_API_KEY=
# Optional Cloudflare CDN integration
ENABLE_GLOBAL_CDN=false
CLOUD_CDN_ZONE_ID=
CLOUD_CDN_API_TOKEN=
# Optional: token for named Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# URL to download custom WAF rules (must use HTTPS)
RULES_DOWNLOAD_URL=https://example.com/custom.rules
# Optional comma-separated list of allowed domains for rule downloads
RULES_ALLOWED_DOMAINS=example.com
# Pin the download to the digest of the file you reviewed (sha256sum custom.rules). Strongly recommended.
# RULES_SHA256=
# Pin the OWASP CRS archive (CRS_DOWNLOAD_URL) the same way. Use a direct archive URL: redirects are not followed.
# CRS_SHA256=
# Refuse downloads that have no pinned digest (default false; downloads are then accepted with a warning)
# RULES_REQUIRE_DIGEST=false
# Limits: RULES_MAX_BYTES (5 MiB), CRS_MAX_DOWNLOAD_BYTES (25 MiB), CRS_MAX_EXTRACTED_BYTES (100 MiB),
# CRS_MAX_FILE_BYTES (20 MiB), CRS_MAX_MEMBERS (5000), CRS_MAX_EXPANSION_RATIO (100)

# SMTP alert credentials
ALERT_SMTP_PASSWORD_FILE=/run/secrets/smtp_password.txt
# Alternatively set ALERT_SMTP_PASSWORD=

# GDPR Compliance
GDPR_ENABLED=true
GDPR_DPO_EMAIL=dpo@example.com
GDPR_DATA_RETENTION_DAYS=365
